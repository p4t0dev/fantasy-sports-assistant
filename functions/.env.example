# Vorlage für functions/.env (gitignored, muss pro Umgebung angelegt werden).
# Enthält bewusst KEINE Geheimnisse — das Refresh-Secret liegt im Secret Manager
# (firebase functions:secrets:set FSA_REFRESH_TOKEN).

# Erlaubte Origins für CORS. Ohne diesen Wert fällt die API auf "*" zurück und
# ist von jeder beliebigen Seite aus aufrufbar.
FSA_ALLOWED_ORIGINS=https://<project-id>.web.app,https://<project-id>.firebaseapp.com

# Sleeper-Usernames (Komma-Liste), deren Wochenübersicht der geplante Job
# morgens, mittags und abends neu berechnet. Ohne Eintrag gibt es keine
# Übersicht - sie wird nie auf Anfrage berechnet.
FSA_SNAPSHOT_USERS=<sleeper-username>
